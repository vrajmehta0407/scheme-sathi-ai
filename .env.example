# SchemeSathi AI Environment Configuration

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL optional for local dev - falls back to SQLite/Memory if not set)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schemesathi_dev

# AI Provider (Optional: if not set, assistant operates in grounded mock fallback mode)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Admin Authentication
ADMIN_SECRET=dev_admin_secret_key_change_in_production

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
